{
  "name": "sonrisas",
  "version": "1.1.2",
  "description": "Sonrisas — control diario de guardería (asistencia, alimentación, actividades y reporte a familias por WhatsApp). Backend NestJS + frontend React en un solo proyecto.",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nest start --watch",
    "dev:web": "vite --config client/vite.config.mjs",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build --config client/vite.config.mjs",
    "build:api": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "lint": "eslint -c client/eslint.config.mjs client",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "ts-node src/database/migrate-cli.ts run",
    "migration:revert": "ts-node src/database/migrate-cli.ts revert",
    "migration:show": "ts-node src/database/migrate-cli.ts show",
    "migration:baseline": "node scripts/generate-baseline.js",
    "migration:run:prod": "node dist/database/migrate-cli.js run",
    "migration:revert:prod": "node dist/database/migrate-cli.js revert",
    "migration:show:prod": "node dist/database/migrate-cli.js show",
    "ops": "ts-node src/ops/cli.ts",
    "ops:prod": "node dist/ops/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axios": "^1.7.9",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.10"
  }
}
