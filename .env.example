# Servidor
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sonrisas
# Desarrollo: true (o vacío) = synchronize automático. Producción usa migraciones (false).
# Crear una migración: npm run migration:generate -- src/database/migrations/NombreDelCambio
DB_SYNC=true

# JWT — mínimo 32 caracteres. Firma también los tokens de acceso a las fotos.
# Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Acceso a /uploads. Aquí viven las FOTOS DE LOS NIÑOS: nunca deben ser públicas.
# Por defecto se exige en producción y se abre en desarrollo (el front corre en otro
# puerto). Ponlo en true para probar el comportamiento real en local.
UPLOADS_REQUIRE_AUTH=false

# CORS / Frontend (separa con coma si tienes varios orígenes)
FRONTEND_URL=http://localhost:5173

# Cuenta de dirección inicial (la crea `npm run seed`).
# Política de contraseñas: mínimo 10 caracteres, con letra y número.
ADMIN_EMAIL=direccion@sonrisas.com
ADMIN_PASSWORD=CambiaEstaClave-2026
ADMIN_NAME=Dirección

# ==========================================================================
#  WhatsApp — envío del reporte diario a las familias
# ==========================================================================
# linked : (por defecto) envío automático desde el WhatsApp del centro, vinculado
#          escaneando un QR en Panel → WhatsApp. Si no está conectado, los envíos
#          fallan con "no está conectado" y se pueden reintentar (no se abren enlaces).
# manual : heredado. Usa el número vinculado si está conectado y, si no, genera
#          enlaces wa.me para enviar a mano. Sólo si se elige explícitamente.
# cloud  : envío automático con la WhatsApp Cloud API de Meta. Requiere cuenta de
#          Meta Business, número verificado y (fuera de la ventana de 24 h) una
#          plantilla aprobada.
WHATSAPP_PROVIDER=linked

# Carpeta donde se guarda la sesión del WhatsApp vinculado (no subir a git).
WHATSAPP_SESSION_DIR=./.wa-auth
# Registro interno de la librería de WhatsApp: silent | warn | info | debug
WHATSAPP_LOG_LEVEL=silent

# Código de país por defecto para números escritos sin prefijo (Ecuador: 593).
WHATSAPP_COUNTRY_CODE=593

# --- Sólo si WHATSAPP_PROVIDER=cloud ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Plantilla aprobada por Meta con un parámetro de cuerpo ({{1}} = texto del reporte).
# Sin ella sólo se puede responder dentro de la ventana de 24 h.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es

# Notificaciones push al personal (VAPID). Genera el par con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:direccion@sonrisas.com

# --- Respaldos en desarrollo (Panel → Respaldos) ---
# Carpeta local de respaldos (por defecto ./backups). En Docker es /backups.
# BACKUP_DIR=./backups
# BACKUP_ENCRYPTION_KEY=
# Carpeta de pg_dump/pg_restore si no están en el PATH (Windows: se detecta solo en
# C:\Program Files\PostgreSQL\<versión>\bin).
# PG_BIN_DIR=
