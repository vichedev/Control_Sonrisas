# ==========================================================================
#  Sonrisas — plantilla del entorno de PRODUCCIÓN
#  Lo normal es que install.sh lo genere solo (con secretos aleatorios). Si lo haces a
#  mano: cp .env.production.example .env.production && chmod 600 .env.production
#  NUNCA lo subas a git.
# ==========================================================================

# Carpeta del proyecto en el servidor (el actualizador la monta en la misma ruta).
SONRISAS_DIR=/opt/sonrisas

# --- Modo de acceso ---
# http  : "puerto directo". Docker publica APP_BIND:APP_PORT → 3000 de la api. Sin Caddy.
#         Se entra por http://IP-o-dominio:8986. Sin HTTPS el navegador NO deja usar la
#         cámara ni instalar la app (PWA): pon delante tu propio proxy con TLS (DEPLOY.md).
# https : Caddy (perfil "https" de docker compose) en 80/443 con Let's Encrypt.
#         La app queda además en 127.0.0.1:APP_PORT (APP_BIND=0.0.0.0 para exponerla).
PUBLIC_MODE=http
APP_PORT=8986
# 0.0.0.0 = accesible desde la red · 127.0.0.1 = sólo desde este servidor (proxy local)
APP_BIND=0.0.0.0
# true sólo si hay un proxy delante (Caddy en modo https, o tu Nginx/Cloudflare): la api
# toma la IP real del cliente de X-Forwarded-For (límites de intentos de inicio de sesión).
TRUST_PROXY=false

# --- Caddy (sólo PUBLIC_MODE=https) ---
# Con un dominio apuntando al servidor -> certificado real de Let's Encrypt automático:
#   SITE_ADDRESS=sonrisas.midominio.com
# Con sólo IP (sin dominio) -> certificado auto-firmado (el navegador avisa una vez):
#   SITE_ADDRESS=203.0.113.10
# En modo http se usa sólo como referencia (la IP o dominio del servidor).
SITE_ADDRESS=tu-dominio.com
HTTP_PORT=80
HTTPS_PORT=443

# Zona horaria de los contenedores. Importante: el sistema razona en días naturales
# (el reporte "de hoy"), así que una TZ equivocada desplaza los registros de la tarde.
TZ=America/Guayaquil

# --- Base de datos PostgreSQL ---
# Nunca se publica fuera de Docker. deploy.sh rechaza claves por defecto o de < 16 caracteres.
# Genera una con: openssl rand -hex 24
# OJO: Postgres sólo lee la clave al crear su volumen; cambiarla después requiere ALTER USER.
DB_USERNAME=sonrisas
DB_PASSWORD=cambia-esta-clave-fuerte
DB_NAME=sonrisas
# false = el esquema se gestiona con MIGRACIONES (nunca synchronize, que puede borrar columnas).
DB_SYNC=false

# --- JWT (mínimo 32 caracteres; genera uno con: openssl rand -base64 48) ---
# El mismo secreto firma los tokens de sesión y los de acceso a las fotos (/uploads).
# Si lo rotas se cierran todas las sesiones y se invalidan los enlaces a las fotos:
# es la palanca de emergencia si sospechas que alguien robó un token.
JWT_SECRET=genera-una-cadena-aleatoria-larga-y-secreta
JWT_EXPIRES_IN=7d

# --- Acceso a las fotos (/uploads) ---
# Son fotos de menores: no se sirven en abierto bajo ningún concepto.
# true (por defecto en producción) exige un token firmado en cada petición.
UPLOADS_REQUIRE_AUTH=true

# --- URLs públicas (mismo origen para SPA y API) ---
# Modo http: http://IP-o-dominio:8986 · modo https o proxy propio: https://tu-dominio.com
# Si empieza por https:// la api envía HSTS y upgrade-insecure-requests a las peticiones
# que llegan por TLS. Una sola URL (se usa también en los mensajes de WhatsApp).
FRONTEND_URL=http://203.0.113.10:8986
BACKEND_URL=http://203.0.113.10:8986

# --- Cuenta de dirección inicial ---
# Déjala VACÍA: install.sh y `./deploy.sh admin` piden la contraseña y se la pasan al
# contenedor por la entrada estándar, sin guardarla en disco. Si la pones aquí (instalación
# a mano), deploy.sh la usa para crear la cuenta y después la BORRA de este archivo.
# Política: mínimo 10 caracteres, con al menos una letra y un número. Activa la
# verificación en dos pasos (2FA) desde Seguridad tras el primer inicio de sesión.
ADMIN_EMAIL=direccion@tu-dominio.com
ADMIN_PASSWORD=
ADMIN_NAME=Dirección

# --- Identidad del centro (valores iniciales de Marca; emisor 2FA y reportes) ---
COMPANY_NAME=Sonrisitas
COMPANY_TAGLINE=Centro de Desarrollo Infantil

# ==========================================================================
#  WhatsApp — envío del reporte diario a las familias
# ==========================================================================
# linked : (por defecto) se envía desde el WhatsApp del centro vinculado con QR
#          (Ajustes → WhatsApp del centro). Si no está conectado, no se envía nada
#          y el sistema lo indica: nunca abre enlaces wa.me.
# manual : (heredado) prepara enlaces wa.me. No recomendado.
# cloud  : envío automático con la WhatsApp Cloud API de Meta.
# La sesión vinculada vive en el volumen sonrisas_wa_auth (WHATSAPP_SESSION_DIR=/app/.wa-auth).
WHATSAPP_PROVIDER=linked
WHATSAPP_LOG_LEVEL=silent
WHATSAPP_COUNTRY_CODE=593

# --- Sólo si WHATSAPP_PROVIDER=cloud ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es

# --- Notificaciones push al personal (VAPID) ---
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:direccion@tu-dominio.com

# ==========================================================================
#  Respaldos (BD + fotos). Ver DEPLOY.md → "Respaldos"
# ==========================================================================
# Cifrado en reposo (AES-256, compatible con openssl). Genera con: openssl rand -hex 32
# ¡GUÁRDALA FUERA DEL SERVIDOR! Sin ella no se puede abrir ningún respaldo cifrado.
# Vacía = respaldos sin cifrar (no recomendado: contienen datos de menores).
BACKUP_ENCRYPTION_KEY=
# Respaldo nocturno (formato cron, hora local TZ)
BACKUP_CRON=15 3 * * *
# Retención: nocturnos que se conservan; de seguridad (antes de actualizar/restaurar/
# volver atrás); y máximo de manuales + subidos (éstos nunca se borran solos por debajo).
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_SAFETY=10
BACKUP_MAX_MANUAL=30
# Tamaño máximo para subir un respaldo desde el navegador (MB)
BACKUP_UPLOAD_MAX_MB=2048
# Copia fuera del servidor (scripts/offsite-copy.sh): UNO de los dos
# OFFSITE_RSYNC=usuario@otro-servidor:/srv/respaldos/sonrisas
# OFFSITE_RCLONE=remoto:sonrisas

# --- Actualizador (contenedor sonrisas_updater) ---
# Cada cuántos minutos consulta las versiones publicadas en GitHub.
UPDATER_FETCH_MINUTES=30
# Restaurar desde la app sin actualizador (no recomendado en producción).
OPS_INPROCESS_RESTORE=false

# --- Límites de memoria de los contenedores ---
# DB_MEM_LIMIT=1g
# API_MEM_LIMIT=1g
